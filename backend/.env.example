# Copy to .env and adjust. No secrets or API keys are needed.
# SQLite by default. For PostgreSQL later: postgresql+psycopg://user:password@host:5432/handoverlab
DATABASE_URL=sqlite:///./handoverlab.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
MAX_SIM_STEPS=12000
MAX_STEP_CELLS=60000
MAX_CONCURRENT_JOBS=2
MAX_STEP_DELAY_MS=2000
